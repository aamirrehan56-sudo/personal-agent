# Copy this file to .env and fill in the values:  cp .env.example .env
# NEVER commit .env to git. It is already listed in .gitignore.

# Postgres connection (matches docker-compose.yml)
DATABASE_URL=postgres://agent:agent@localhost:5432/agent
# Separate database used only by the automated tests (it gets wiped)
TEST_DATABASE_URL=postgres://agent:agent@localhost:5432/agent_test

PORT=3000
# Set to true when the site is served over HTTPS (in production)
COOKIE_SECURE=false

# One-time code needed to create your account on first run.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
SETUP_CODE=change-me

# 32-byte key (64 hex characters) used to encrypt stored tokens (AES-256-GCM).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Claude API key from https://console.anthropic.com (kept on the server only)
ANTHROPIC_API_KEY=
# Which Claude model the agent uses. claude-opus-5-5 is the most capable default;
# claude-sonnet-5-5 or claude-haiku-5-5 are cheaper (see README "Running costs").
AI_MODEL=claude-opus-5-5
# How hard the model thinks: low | medium | high
AI_EFFORT=low

TIMEZONE=Australia/Melbourne
